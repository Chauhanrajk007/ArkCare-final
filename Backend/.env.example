# ArkCare FastAPI backend environment
# Keep real values in your deployment environment. This file is documentation only.

GROQ_API_KEY=
PINECONE_API_KEY=

# Optional Pinecone overrides
PINECONE_INDEX_NAME=medical-doctors
PINECONE_DIMENSION=384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=

# Public backend origin, e.g. https://medical-ai-backend.onrender.com
AI_SERVER_URL=http://localhost:8000

# Optional shared secret. If set, use the SAME value in Frontend AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=
