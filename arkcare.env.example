# ArkCare runtime environment template.
# Copy to `arkcare.env` at the repo root and fill in real values.
# `arkcare.env` is git-ignored on purpose - never commit real secrets.

AUTH_SECRET=

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/arkcare?retryWrites=true&w=majority

NEXT_PUBLIC_APP_URL=http://localhost:3000

GROQ_API_KEY=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Local AI service defaults. Override these in deployed frontend environments.
AI_CHAT=http://127.0.0.1:8000/chat
AI_PDF=http://127.0.0.1:8000/parse_report
AI_SERVER_URL=http://127.0.0.1:8000

# Optional shared token between Next.js and FastAPI.
AI_INTERNAL_TOKEN=

# Optional external scanner module.
NEXT_PUBLIC_SCANNER_URL=

# Optional. If omitted, backend falls back to local doctor search.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=arkcare
PINECONE_DIMENSION=1024
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=BAAI/bge-large-en-v1.5

# MST Blockchain Testnet Configuration
# The chain is the MST public testnet. There is no local EVM: these values are
# the only chain settings, and the bridge reads them straight out of this file.
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CAREQUEST_BLOCKCHAIN_ENABLED=true
CAREQUEST_BLOCKCHAIN_BRIDGE_URL=http://127.0.0.1:8546
# Port the bridge listens on. Change only if 8546 is already taken.
CAREQUEST_BLOCKCHAIN_BRIDGE_PORT=8546
# Block explorer the audit dashboard links transaction hashes to.
CAREQUEST_BLOCKCHAIN_EXPLORER_URL=https://testnet.mstscan.com
# Required. The public RPC cannot sign for the accounts it lists, so the bridge
# holds the key that owns the contract roles. This is the only place a chain key
# exists - it is never sent to the browser and the bridge stays on 127.0.0.1.
# On Render this becomes a `sync: false` secret on the arkcare-bridge service
# (see render.yaml), and the service must be set to Private.
# Get testnet tokens from: https://faucet.masterstroke.academy
# Deploy the contracts and grant the roles with: cd Blockchain && npm run deploy:mst
BRIDGEKEY_PRIVATE_KEY=

# Only needed when the bridge is NOT on this machine (e.g. hosted on Render).
# Leave it EMPTY locally: the bridge is loopback-only and requires no token.
# On Render, set the same generated value on the frontend and the bridge - it is
# the shared secret that lets the app ask the signer to act.
CAREQUEST_BLOCKCHAIN_BRIDGE_TOKEN=

# Set to 0.0.0.0 ONLY in a container that must accept network traffic (Render).
# Locally the bridge defaults to 127.0.0.1 so it can never be reached off-box.
# Binding 0.0.0.0 without a token above makes the bridge refuse to start.
CAREQUEST_BLOCKCHAIN_BRIDGE_HOST=127.0.0.1
